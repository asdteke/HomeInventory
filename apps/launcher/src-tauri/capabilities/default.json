{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal launcher permissions. Process and file operations are handled only by validated Rust commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "core:window:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}

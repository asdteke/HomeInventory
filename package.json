{
  "name": "home-inventory",
  "version": "2.0.1",
  "description": "Private, self-hostable household inventory for shared homes",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:brand": "node scripts/dev-brand.mjs",
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "NODE_ENV=production node server.js",
    "install-all": "npm install && cd client && npm install",
    "security:backfill-encryption": "node scripts/run-with-runtime-secrets.mjs scripts/backfill-field-encryption.mjs",
    "test:encryption": "node --test tests/encryption.test.mjs",
    "test:runtime-secrets": "node --test tests/runtimeSecrets.test.mjs",
    "indexnow:submit": "node scripts/run-with-runtime-secrets.mjs scripts/indexnow-submit.mjs",
    "i18n:check": "node scripts/check-i18n-completeness.mjs",
    "translate": "node scripts/api-translate.mjs",
    "translate:dry": "node scripts/api-translate.mjs --dry-run"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.6.0",
    "bing-translate-api": "^4.2.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "follow-redirects": "^1.16.0",
    "helmet": "^8.1.0",
    "i18next": "^25.7.4",
    "i18next-fs-backend": "^2.6.5",
    "i18next-http-middleware": "^3.9.6",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "npmlog": "^7.0.1",
    "oci-sdk": "^2.126.3",
    "otpauth": "^9.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "resend": "^6.1.3",
    "sharp": "^0.34.5",
    "uuid": "file:./vendor/uuid",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "oci-common": {
      "uuid": "file:./vendor/uuid"
    }
  }
}

{
  "name": "home-inventory",
  "version": "2.7.0",
  "description": "Private, self-hostable household inventory for shared homes",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:brand": "node scripts/dev-brand.mjs",
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:homeinventory": "npm run build --prefix client",
    "start": "NODE_ENV=production node server.js",
    "install-all": "npm install && cd client && npm install",
    "launcher:install": "npm install --prefix apps/launcher",
    "launcher:dev": "npm run tauri --prefix apps/launcher -- dev",
    "launcher:build": "node scripts/build-launcher.mjs",
    "launcher:bundle-app": "node scripts/build-managed-app-archive.mjs",
    "store:windows": "node scripts/build-store-windows.mjs",
    "release:app-manifest": "node scripts/create-app-release-manifest.mjs",
    "release:tauri-latest": "node scripts/create-tauri-latest-json.mjs",
    "security:backfill-encryption": "node scripts/run-with-runtime-secrets.mjs scripts/backfill-field-encryption.mjs",
    "test:encryption": "node --test tests/encryption.test.mjs",
    "test:runtime-secrets": "node --test tests/runtimeSecrets.test.mjs",
    "indexnow:submit": "node scripts/run-with-runtime-secrets.mjs scripts/indexnow-submit.mjs",
    "i18n:check": "node scripts/check-i18n-completeness.mjs",
    "version:check": "node scripts/check-version-parity.mjs",
    "translate": "node scripts/api-translate.mjs",
    "translate:dry": "node scripts/api-translate.mjs --dry-run"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.6.0",
    "bing-translate-api": "^4.2.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "follow-redirects": "^1.16.0",
    "helmet": "^8.1.0",
    "i18next": "^25.7.4",
    "i18next-http-middleware": "^3.9.7",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "npmlog": "^7.0.1",
    "oci-sdk": "^2.126.3",
    "otpauth": "^9.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "resend": "^6.1.3",
    "sharp": "^0.35.3",
    "uuid": "file:./vendor/uuid",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "sharp": true
  },
  "overrides": {
    "body-parser": "1.20.6",
    "shell-quote": "1.10.0",
    "oci-common": {
      "uuid": "file:./vendor/uuid"
    }
  }
}
